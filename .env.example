PORT=8000
NODE_ENV=development

JWT_SECRET_TOKEN=your_jwt_secret_token
JWT_REFRESH_TOKEN=your_jwt_refresh_token
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

DATABASE_URL=postgresql://username:password@localhost:5432/database_name
BACKEND_URL=http://localhost:8000

# redis > 
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://username:password@localhost:6379

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_from_email

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/user/auth/google/callback
FRONT_END_URL=http://localhost:5173

#AI
AI_SERVICE_URL=https://your_ai_service_url/api

#VAPI
# VAPI_API_KEY=your_vapi_api_key
# VAPI_PUBLIC_KEY=your_vapi_public_key

VAPI_API_KEY=your_vapi_api_key
VAPI_PUBLIC_KEY=your_vapi_public_key

# WEBHOOK FORWARDING SECURITY
WEBHOOK_FORWARD_SECRET=your_webhook_forward_secret

#Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
